{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "scope",
          "match": "staging.read",
          "claims": {
            "sub": "account-upgrade-service",
            "aud": [
              "api://account-upgrade"
            ],
            "scp": [
              "staging.read"
            ]
          }
        },
        {
          "requestParam": "scope",
          "match": "audit.read",
          "claims": {
            "sub": "local-auditor",
            "aud": [
              "api://account-upgrade"
            ],
            "scp": [
              "audit.read"
            ]
          }
        },
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "aud": [
              "api-gateway",
              "api://account-upgrade"
            ],
            "azp": "api-gateway"
          }
        }
      ]
    }
  ]
}

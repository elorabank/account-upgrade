# Source this to point a service at the secured local Kafka, then set that service's own login:
#   source infra/kafka-secure/app.env
#   export BANK_KAFKA_SASL_USERNAME=communication-service BANK_KAFKA_SASL_PASSWORD=communication-service-kafka-local-pw
#   mvn -pl communication-service spring-boot:run
export BANK_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
export BANK_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_SSL
export BANK_KAFKA_PROPERTIES_SSL_TRUSTSTORE_TYPE=PKCS12
export BANK_KAFKA_PROPERTIES_SSL_TRUSTSTORE_LOCATION="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/certs/truststore.p12"
export BANK_KAFKA_PROPERTIES_SSL_TRUSTSTORE_PASSWORD=kafka-local-tls

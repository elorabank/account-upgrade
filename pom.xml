<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.bank.upgrade</groupId>
  <artifactId>account-upgrade-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>account-upgrade-parent</name>

  <modules>
    <module>common</module>
    <module>common-test</module>
    <module>file-ingestion-service</module>
    <module>account-upgrade-service</module>
    <module>communication-service</module>
    <module>audit-service</module>
    <module>ops-ui</module>
    <module>api-gateway</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <spring-cloud.version>2025.1.4</spring-cloud.version>
    <blockhound.version>1.0.18.RELEASE</blockhound.version>
    <shedlock.version>6.10.0</shedlock.version>
    <reactor-kafka.version>1.3.25</reactor-kafka.version>
    <sshj.version>0.41.2</sshj.version>
    <poi.version>6.0.0</poi.version>
    <excel-streaming-reader.version>6.0.0</excel-streaming-reader.version>
    <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
    <node.version>v22.12.0</node.version>
    <jacoco.version>0.8.16</jacoco.version>
    <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
    <dependency-check.version>12.2.2</dependency-check.version>
    <!-- Filled by JaCoCo's agent; empty when tests run without it -->
    <argLine></argLine>
    <!-- SonarCloud (CI, when the SONAR_TOKEN secret is set) -->
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.organization>elorabank</sonar.organization>
    <sonar.projectKey>elorabank_account-upgrade</sonar.projectKey>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.bank.upgrade</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bank.upgrade</groupId>
        <artifactId>common-test</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bank.upgrade</groupId>
        <artifactId>ops-ui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.projectreactor.kafka</groupId>
        <artifactId>reactor-kafka</artifactId>
        <version>${reactor-kafka.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hierynomus</groupId>
        <artifactId>sshj</artifactId>
        <version>${sshj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.pjfanning</groupId>
        <artifactId>excel-streaming-reader</artifactId>
        <version>${excel-streaming-reader.version}</version>
      </dependency>
      <dependency>
        <groupId>net.javacrumbs.shedlock</groupId>
        <artifactId>shedlock-spring</artifactId>
        <version>${shedlock.version}</version>
      </dependency>
      <dependency>
        <groupId>net.javacrumbs.shedlock</groupId>
        <artifactId>shedlock-provider-jdbc-template</artifactId>
        <version>${shedlock.version}</version>
      </dependency>
      <dependency>
        <groupId>io.projectreactor.tools</groupId>
        <artifactId>blockhound</artifactId>
        <version>${blockhound.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- JaCoCo's agent (@{argLine}), and the flag BlockHound needs on JDK 13+ -->
            <argLine>@{argLine} -XX:+AllowRedefinitionToAddDeleteMethods</argLine>
          </configuration>
        </plugin>
        <plugin>
          <!-- mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar (CI runs it when SONAR_TOKEN is set) -->
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <!-- Known vulnerabilities in the dependencies: mvn org.owasp:dependency-check-maven:aggregate
               (weekly in CI, .github/workflows/security.yml). Needs an NVD API key in NVD_API_KEY. -->
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>${dependency-check.version}</version>
          <configuration>
            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
            <formats>
              <format>HTML</format>
              <format>JSON</format>
            </formats>
            <!-- Fail on critical findings (CVSS 9+); the report lists everything -->
            <failBuildOnCVSS>9</failBuildOnCVSS>
            <!-- The ops console's npm packages are watched by Dependabot instead; OSS Index needs its own login -->
            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
            <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
            <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!-- Test coverage of every module: target/site/jacoco/index.html after mvn verify (Sonar reads the XML) -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
